# Core dev works without secrets. Keys below are optional/replaceable with mocks.

# Perplexity API Key for AI Summarization (optional)
# Get your API key from: https://www.perplexity.ai/settings/api
EXPO_PUBLIC_PERPLEXITY_API_KEY=your_api_key_here

# Sentry DSN for crash reporting (optional but recommended for beta)
# Get your DSN from: https://sentry.io/organizations/<your-org>/projects/
# Note: Sentry.init() is skipped entirely when this is unset, so crash
# reporting is off unless it is also set in the EAS environment.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source map upload. Required to publish an OTA update to production
# (see docs/standards/adr/0006-over-the-air-updates.md) and to symbolicate
# crashes from released builds. The auth token is a secret - set it as an EAS
# environment variable with "Sensitive" visibility, never in a committed file.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional feedback form URL (used when email composer is unavailable)
EXPO_PUBLIC_FEEDBACK_FORM_URL=
