{
  "expo": {
    "name": "Abridgd",
    "slug": "abridged",
    "scheme": "abridged",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F7",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0C0C0C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mccalmedia.abridged",
      "buildNumber": "41",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCrashData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Abridgd opens your calendar's new-event screen so you can add a local event. It does not read your calendar.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Abridgd opens your calendar's new-event screen so you can add a local event. It does not read your calendar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mccalmedia.abridged",
      "versionCode": 41,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "./plugins/withFoldableConfigChanges",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Teal",
            "ios": "./assets/app-icons/teal.png",
            "android": {
              "foregroundImage": "./assets/app-icons/teal-foreground.png",
              "backgroundColor": "#3E7F73"
            }
          },
          {
            "name": "Berry",
            "ios": "./assets/app-icons/berry.png",
            "android": {
              "foregroundImage": "./assets/app-icons/berry-foreground.png",
              "backgroundColor": "#7F3E4A"
            }
          },
          {
            "name": "Paper",
            "ios": "./assets/app-icons/paper.png",
            "android": {
              "foregroundImage": "./assets/app-icons/paper-foreground.png",
              "backgroundColor": "#F1EFE8"
            }
          }
        ]
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "abridgd",
          "organization": "mccal-media"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b4182600-fb7c-4d97-a405-1fc367232289"
      }
    },
    "owner": "mccal-media",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b4182600-fb7c-4d97-a405-1fc367232289"
    }
  }
}
